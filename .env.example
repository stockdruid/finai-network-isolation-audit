# ─────────────────────────────────────────────────────────────
# finai-compliance 환경변수 예시
# 사본을 `.env`로 복사한 뒤 값을 채워 넣어라. `.env`는 커밋 금지.
# 위치별로 값이 달라지는 항목은 아래 표를 참조.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (chatbot_logs 단일 진실원)
# 로컬 호스트 실행:      postgresql+asyncpg://finai:finai@localhost:5432/finai
# docker compose:        postgresql+asyncpg://finai:finai@postgres:5432/finai
# AWS RDS:               postgresql+asyncpg://<user>:<pw>@<rds-endpoint>:5432/finai
DATABASE_URL=postgresql+asyncpg://finai:finai@localhost:5432/finai

# Streamlit → FastAPI 통신
# 로컬 호스트 실행:      http://localhost:8000
# docker compose:        http://api:8000
# AWS 같은 EC2 내부:     http://127.0.0.1:8000
FASTAPI_BASE_URL=http://localhost:8000

# Ollama (내부 LLM, VPC A)
# 로컬 호스트 실행:      http://localhost:11434
# docker compose:        http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SEC=30

# Mock External LLM (VPC B 시뮬레이션 — EV-001 위반 시나리오)
EXTERNAL_LLM_URL=https://api.openai-mock.example.com
EXTERNAL_LLM_TIMEOUT_SEC=10

# Chroma + 임베딩
CHROMA_PATH=./data/chroma
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
RAG_TOP_K=5

# 데이터 적재 API 키
FINLIFE_API_KEY=
ECOS_API_KEY=

# 로깅
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── AWS (배포 시) ───────────────────────────────────────────
# AWS_REGION=ap-northeast-2
# S3_BUCKET_REPORTS=finai-compliance-reports
# CLOUDWATCH_LOG_GROUP=/finai/compliance
